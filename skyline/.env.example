# OnTheTape Partner /v1 — names only, never commit real keys.
# Local Diego preview (not reachable from cloud agents):
# ONTATAPE_API_BASE=http://127.0.0.1:8099
# After onthetape PR #34:
# ONTATAPE_API_BASE=https://site-staging-eb18.up.railway.app
# ONTATAPE_API_BASE=https://onthetape.io

ONTATAPE_API_BASE=
ONTATAPE_API_KEY=
API_V1_DEV_KEY=

# Staging-only visual simulator + demo buttons. Never silently on in production.
ENABLE_DEMO_MODE=true

# Public site URL used for CORS allow-list (comma-separated extras in CORS_ORIGINS).
PUBLIC_BASE_URL=https://staging.payoutstreet.com
CORS_ORIGINS=https://staging.payoutstreet.com,http://localhost:8080,http://127.0.0.1:8080

# Optional staging gate. If set, every non-health request needs
# header X-Staging-Token or ?access=
STAGING_ACCESS_TOKEN=

# Force fixtures even if a base URL is set (useful while /v1 404s).
FORCE_FIXTURE_MODE=false

PORT=8080
NODE_ENV=development
UPSTREAM_TIMEOUT_MS=8000
PAYOUT_POLL_MS=12000
RANKING_REFRESH_MS=60000
